{
  "manifest_version": 3,
  "name": "Pip AI Room",
  "version": "1.0.0",
  "description": "Gemini, ChatGPT and Claude research together. Pip carries their messages, runs their tools and keeps one shared memory.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open the Pip AI Room",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*"
  ],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "src/pip/engine.js",
        "src/pip/dock.js",
        "src/content/sites.js",
        "src/content/driver.js",
        "src/content/agent.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
